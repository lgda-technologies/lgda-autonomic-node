# Copy to .env for local dev. NEVER commit a real .env or a private key.

# Public base URL used in the MCP manifest and x402 resource URLs.
BASE_URL=https://lgda-music.fly.dev

# --- x402 payments ---
# Dev default: base-sepolia testnet (no real money).
# MAINNET SWITCH: set X402_NETWORK=base AND confirm PAY_TO_ADDRESS is the
# owner's real mainnet wallet. The USDC asset is selected automatically
# (base-sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e,
#  base: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913).
X402_NETWORK=base-sepolia
# Owner-confirmed wallet (2026-11-17); mainnet USDC settles here.
PAY_TO_ADDRESS=0x8da12fca05e38aeda66f112fcf2ef6036c7bd666
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Receipt signing key (Ed25519) ---
# If set, the node uses this key (base64 raw 32-byte seed). If unset, it
# loads data/receipt_key.json, or generates one there on first run.
# In production set this as a Fly secret so the key survives redeploys.
# RECEIPT_PRIVATE_KEY_B64=
# RECEIPT_KEY_FILE=./data/receipt_key.json

# --- Audio ---
# Directory of MP3s, one per track_id: <track_id>.mp3 (e.g. midnight.mp3).
AUDIO_DIR=./audio

# --- Stripe (not implemented in v2) ---
# /pay/stripe returns {"enabled": false} until STRIPE_SECRET_KEY is set,
# and 501 after that until catalog checkout is built. Do not set this
# expecting Stripe payments to work yet.
# STRIPE_SECRET_KEY=
